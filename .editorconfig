# Quatro pessoas, editores e sistemas diferentes.
# Sem isto, metade dos diffs vira ruído de fim de linha e indentação.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
# Em Markdown, dois espaços no fim da linha significam quebra de linha.
trim_trailing_whitespace = false

[*.sql]
indent_size = 4

[{composer.json,composer.lock}]
indent_size = 4
