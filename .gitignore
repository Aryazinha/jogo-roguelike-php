# Dependências — reconstruídas por `composer install`
/vendor/

# Binário do Raylib — cada integrante baixa o seu, ver docs/AMBIENTE.md
/lib/*
!/lib/.gitkeep

# Banco de dados gerado — versionamos as migrações, não o arquivo.
# Banco binário no Git gera conflito de merge que não se resolve.
/database/*.sqlite
/database/*.sqlite-wal
/database/*.sqlite-shm
/database/*.db

# Saídas de ferramentas
/tools/output/
*.log
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache

# Editores e IDEs
.idea/
.vscode/
*.code-workspace
*.swp
*~

# Sistema operacional
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Ambiente local
.env
.env.local
